{
  "name": "@omniharness/test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:e2e": "vitest run --dir src/e2e",
    "test:security": "vitest run --dir src/security"
  },
  "dependencies": {
    "@omniharness/shared-types": "workspace:*",
    "@omniharness/agent-protocol": "workspace:*",
    "@omniharness/client-sdk": "workspace:*",
    "@omniharness/policy-engine": "workspace:*",
    "@omniharness/sandbox-engine": "workspace:*",
    "@omniharness/workspace-manager": "workspace:*",
    "@omniharness/observability": "workspace:*",
    "@omniharness/session-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
