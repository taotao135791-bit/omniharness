{
  "name": "@omniharness/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "omni": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@omniharness/agent-protocol": "workspace:*",
    "@omniharness/client-sdk": "workspace:*",
    "@omniharness/config-schema": "workspace:*",
    "@omniharness/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
