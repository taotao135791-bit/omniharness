{
  "name": "@omniharness/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main/dev.ts",
    "test": "vitest run",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@omniharness/agent-protocol": "workspace:*",
    "@omniharness/client-sdk": "workspace:*",
    "@omniharness/config-schema": "workspace:*",
    "@omniharness/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
